---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Icon from "@/components/Icon.astro";
import MotionButton from "@/components/react/MotionButton.tsx";
import MagneticButton from "@/components/react/MagneticButton.tsx";
import MotionCard from "@/components/react/MotionCard.tsx";
import StatCounter from "@/components/react/StatCounter.tsx";
import RotatingText from "@/components/react/RotatingText.tsx";
import { site } from "@/data/site";
import { featuredProjects } from "@/data/projects";
import { stats, values } from "@/data/about";
import { withBase } from "@/lib/url";

const marquee = [
  "TypeScript", "React", "Next.js", "Astro", "Node.js", "Tailwind CSS",
  "PostgreSQL", "GraphQL", "Docker", "AWS", "Vue", "Playwright",
];
const valueIcons = ["gauge", "a11y", "sparkles"];
const roles = ["Full-Stack Developer", "Frontend Engineer", "UI/UX Engineer"];
---
<BaseLayout>
  <!-- ================= HERO ================= -->
  <section class="relative overflow-hidden" data-hero>
    <!-- pointer-tracking spotlight (desktop, motion-safe) -->
    <div class="pointer-events-none absolute inset-0 -z-10" data-spotlight aria-hidden="true"></div>

    <div class="container-page pb-14 pt-12 sm:pt-16">
      <div class="mx-auto max-w-3xl text-center">
        <!-- availability pill -->
        <div
          class="inline-flex items-center gap-2.5 rounded-full border border-border/70 bg-card/60 px-4 py-1.5 font-mono text-xs text-muted-foreground backdrop-blur"
          data-hero-item
        >
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          {site.status}
          <span class="h-3 w-px bg-border-strong"></span>
          <span class="inline-flex items-center gap-1">
            <Icon name="map-pin" size={12} /> Remote
          </span>
        </div>

        <!-- headline: name + rotating role (Framer Motion) -->
        <h1 class="mt-7 leading-[1.03] tracking-tight">
          <span
            class="block font-extrabold text-foreground text-[clamp(2.7rem,8.5vw,5rem)]"
            data-hero-item
          >
            Hamza <span class="gradient-text">Javed</span>
          </span>
          <span
            class="mt-3 block pb-[0.12em] font-bold text-[clamp(1.3rem,4vw,2.15rem)]"
            data-hero-item
          >
            <RotatingText words={roles} client:load />
          </span>
        </h1>

        <p
          class="mx-auto mt-6 max-w-xl text-balance text-base leading-relaxed text-muted-foreground sm:text-lg"
          data-hero-item
        >
          {site.tagline} I turn ideas into polished, production-ready web
          experiences — fast, accessible, and built to last.
        </p>

        <!-- credibility stats -->
        <ul
          class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 font-mono text-sm"
          data-hero-item
        >
          <li class="text-muted-foreground"><span class="font-semibold text-foreground">6+</span> years</li>
          <li aria-hidden="true" class="h-1 w-1 rounded-full bg-border-strong"></li>
          <li class="text-muted-foreground"><span class="font-semibold text-foreground">40+</span> projects</li>
          <li aria-hidden="true" class="h-1 w-1 rounded-full bg-border-strong"></li>
          <li class="text-muted-foreground"><span class="font-semibold text-foreground">20+</span> clients</li>
        </ul>

        <!-- magnetic CTAs -->
        <div
          class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"
          data-hero-item
        >
          <MagneticButton href={withBase("/projects")} label="View my work" variant="primary" full client:load />
          <MagneticButton href={withBase("/contact")} label="Get in touch" variant="ghost" full client:load />
        </div>
      </div>
    </div>

    <!-- scroll cue -->
    <div class="flex justify-center pb-6" data-hero-item>
      <a
        href="#work"
        aria-label="Scroll to featured work"
        class="group inline-flex flex-col items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-muted-foreground transition-colors hover:text-foreground"
      >
        Scroll
        <span class="flex h-9 w-5 justify-center rounded-full border border-border-strong pt-1.5">
          <span class="h-1.5 w-1 rounded-full bg-accent animate-scroll-dot"></span>
        </span>
      </a>
    </div>

    <!-- Tech marquee -->
    <div class="relative flex overflow-hidden border-y border-border/60 bg-card/30 py-4">
      <div class="flex shrink-0 animate-marquee items-center gap-8 pr-8">
        {marquee.map((t) => (
          <span class="flex items-center gap-8 font-mono text-sm text-muted-foreground">
            {t}
            <span class="h-1 w-1 rounded-full bg-accent/60"></span>
          </span>
        ))}
      </div>
      <div class="flex shrink-0 animate-marquee items-center gap-8 pr-8" aria-hidden="true">
        {marquee.map((t) => (
          <span class="flex items-center gap-8 font-mono text-sm text-muted-foreground">
            {t}
            <span class="h-1 w-1 rounded-full bg-accent/60"></span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= FEATURED WORK ================= -->
  <section id="work" class="container-page py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="Selected work" title="Featured projects">
        <p class="max-w-md text-sm leading-relaxed text-muted-foreground">
          A few things I've designed and shipped recently.
        </p>
      </SectionHeading>
      <a
        href={withBase("/projects")}
        class="link-underline hidden items-center gap-1.5 font-mono text-sm text-foreground sm:inline-flex"
        data-reveal
      >
        All projects
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="mt-10 grid gap-6">
      <div data-reveal>
        <MotionCard className="h-full" client:visible>
          <ProjectCard project={featuredProjects[0]} featured />
        </MotionCard>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {
          featuredProjects.slice(1, 3).map((p) => (
            <div data-reveal class="h-full">
              <MotionCard className="h-full" client:visible>
                <ProjectCard project={p} />
              </MotionCard>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= VALUES / ABOUT TEASER ================= -->
  <section class="container-page py-8">
    <div class="rounded-3xl border border-border/70 bg-card/40 p-8 sm:p-12">
      <SectionHeading eyebrow="How I work" title="Craft over shortcuts" align="center">
        <p class="mx-auto max-w-xl text-sm leading-relaxed text-muted-foreground">
          Principles that shape everything I build.
        </p>
      </SectionHeading>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          values.map((v, i) => (
            <div data-reveal class="h-full">
              <MotionCard className="h-full" lift={5} client:visible>
                <div class="h-full rounded-2xl border border-border/60 bg-background/50 p-6 transition-colors hover:border-border-strong">
                  <div class="grid h-11 w-11 place-items-center rounded-xl bg-accent/10 text-accent">
                    <Icon name={valueIcons[i] ?? "bolt"} />
                  </div>
                  <h3 class="mt-5 text-lg font-bold">{v.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{v.body}</p>
                </div>
              </MotionCard>
            </div>
          ))
        }
      </div>

      <div class="mt-10 grid grid-cols-2 gap-6 border-t border-border/60 pt-8 sm:grid-cols-4">
        {
          stats.map((s) => (
            <div data-reveal>
              <StatCounter value={s.value} label={s.label} client:visible />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="container-page py-20">
    <div
      class="relative overflow-hidden rounded-3xl border border-accent/30 bg-gradient-to-br from-card to-background p-10 text-center sm:p-16"
      data-reveal
    >
      <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-accent/20 blur-3xl animate-float"></div>
      <h2 class="relative text-3xl font-bold sm:text-4xl">Have a project in mind?</h2>
      <p class="relative mx-auto mt-4 max-w-md text-muted-foreground">
        I'm currently available for freelance work and collaborations. Let's
        build something great together.
      </p>
      <div class="relative mt-8 flex justify-center">
        <MotionButton href={withBase("/contact")} label="Start a conversation" client:visible />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  [data-spotlight] {
    background: radial-gradient(
      520px circle at var(--mx, 50%) var(--my, 20%),
      rgba(34, 197, 94, 0.14),
      transparent 45%
    );
    opacity: var(--spot, 0);
    transition: opacity 0.5s ease;
  }
</style>

<script>
  // Pointer-tracking hero spotlight — desktop + motion-safe only.
  function initSpotlight() {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    const layer = hero?.querySelector<HTMLElement>("[data-spotlight]");
    if (!hero || !layer) return;
    if (
      window.matchMedia("(pointer: coarse)").matches ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      return;
    }
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      layer.style.setProperty("--mx", `${e.clientX - r.left}px`);
      layer.style.setProperty("--my", `${e.clientY - r.top}px`);
      layer.style.setProperty("--spot", "1");
    });
    hero.addEventListener("pointerleave", () => {
      layer.style.setProperty("--spot", "0");
    });
  }

  document.addEventListener("astro:page-load", initSpotlight);
</script>
