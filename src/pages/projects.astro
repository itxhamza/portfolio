---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Icon from "@/components/Icon.astro";
import MotionCard from "@/components/react/MotionCard.tsx";
import { projects } from "@/data/projects";

// Unique tags for the (progressive-enhancement) filter bar.
const allTags = Array.from(new Set(projects.flatMap((p) => p.tags))).sort();
---
<BaseLayout
  title="Projects"
  description="A selection of projects — web apps, tools, and design systems built with modern web tech."
>
  <section class="container-page">
    <SectionHeading eyebrow="Portfolio" title="Things I've built">
      <p class="max-w-lg text-sm leading-relaxed text-muted-foreground">
        A mix of client work, products, and open-source. Each one shipped with
        an eye for performance, accessibility, and detail.
      </p>
    </SectionHeading>

    <!-- Filter bar -->
    <div
      class="mt-8 flex flex-wrap gap-2"
      data-reveal
      role="group"
      aria-label="Filter projects by technology"
    >
      <button
        type="button"
        class="rounded-lg border border-border-strong bg-accent px-3 py-1.5 font-mono text-xs font-semibold text-accent-foreground transition-colors"
        data-filter="all"
        aria-pressed="true"
      >
        All
      </button>
      {
        allTags.map((tag) => (
          <button
            type="button"
            class="rounded-lg border border-border/70 bg-card/50 px-3 py-1.5 font-mono text-xs text-muted-foreground transition-colors hover:border-border-strong hover:text-foreground"
            data-filter={tag}
            aria-pressed="false"
          >
            {tag}
          </button>
        ))
      }
    </div>

    <div
      class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
      data-project-grid
    >
      {
        projects.map((p) => (
          <div data-reveal data-tags={p.tags.join("|")} class="h-full">
            <MotionCard className="h-full" client:visible>
              <ProjectCard project={p} />
            </MotionCard>
          </div>
        ))
      }
    </div>

    <p
      class="mt-10 hidden items-center justify-center gap-2 rounded-xl border border-border/60 bg-card/40 px-4 py-6 text-center font-mono text-sm text-muted-foreground"
      data-empty
    >
      <Icon name="close" size={16} />
      No projects match that filter.
    </p>
  </section>
</BaseLayout>

<script>
  function initFilters() {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-filter]"),
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-tags]"),
    );
    const empty = document.querySelector<HTMLElement>("[data-empty]");
    if (!buttons.length) return;

    const setActive = (active: HTMLButtonElement) => {
      buttons.forEach((b) => {
        const on = b === active;
        b.setAttribute("aria-pressed", String(on));
        b.classList.toggle("bg-accent", on);
        b.classList.toggle("text-accent-foreground", on);
        b.classList.toggle("font-semibold", on);
        b.classList.toggle("border-border-strong", on);
        b.classList.toggle("bg-card/50", !on);
        b.classList.toggle("text-muted-foreground", !on);
        b.classList.toggle("border-border/70", !on);
      });
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter;
        setActive(btn);
        let visible = 0;
        cards.forEach((card) => {
          const tags = (card.dataset.tags ?? "").split("|");
          const show = filter === "all" || tags.includes(filter ?? "");
          card.classList.toggle("hidden", !show);
          if (show) visible++;
        });
        empty?.classList.toggle("hidden", visible > 0);
        empty?.classList.toggle("flex", visible === 0);
      });
    });
  }

  initFilters();
  document.addEventListener("astro:after-swap", initFilters);
</script>
