---
import type { Project } from "@/data/projects";
import Icon from "@/components/Icon.astro";
interface Props {
  project: Project;
  featured?: boolean;
}
const { project, featured = false } = Astro.props;
const href = project.link ?? project.repo ?? "#";
const external = href.startsWith("http");
---
<article
  class:list={[
    "group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border/70 bg-card/50 transition-colors duration-300 hover:border-border-strong hover:bg-card",
    featured ? "md:flex-row" : "",
  ]}
>
  <!-- Cover -->
  <div
    class:list={[
      "relative overflow-hidden",
      featured ? "md:w-2/5" : "",
    ]}
  >
    <div
      class="aspect-[16/10] w-full transition-transform duration-500 group-hover:scale-105"
      style={`background:${project.accent}`}
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-card/90 via-transparent to-transparent"></div>
    <span
      class="absolute left-4 top-4 rounded-full border border-white/20 bg-black/30 px-2.5 py-1 font-mono text-xs text-white backdrop-blur-md"
    >
      {project.year}
    </span>
  </div>

  <!-- Body -->
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-accent">
      <Icon name="layers" size={14} />
      {project.role}
    </div>

    <h3 class="mt-3 text-xl font-bold">
      <a href={href} {...external ? { target: "_blank", rel: "noreferrer" } : {}} class="after:absolute after:inset-0">
        {project.title}
      </a>
    </h3>

    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
      {featured ? project.description : project.summary}
    </p>

    <ul class="mt-4 flex flex-wrap gap-2">
      {
        project.tags.map((tag) => (
          <li class="rounded-md border border-border/70 bg-muted/50 px-2 py-1 font-mono text-xs text-foreground/80">
            {tag}
          </li>
        ))
      }
    </ul>

    <div class="mt-auto flex items-center gap-4 pt-6 font-mono text-sm">
      <span class="inline-flex items-center gap-1.5 text-foreground transition-colors group-hover:text-accent">
        View project
        <Icon name="arrow-up-right" size={16} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </span>
    </div>
  </div>
</article>
